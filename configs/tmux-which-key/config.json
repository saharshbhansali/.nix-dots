    { "key": ":", "type": "tmux", "command": "command-prompt", "description": "Command prompt" },
    { "key": "r", "type": "tmux", "command": "run \"sh -c '\\\"$TMUX_PROGRAM\\\" \\${TMUX_SOCKET:+-S \\\"$TMUX_SOCKET\\\"} source \\\"$TMUX_CONF\\\"'\" \\; display \"Configuration reloaded\"", "description": "Reload config" },
