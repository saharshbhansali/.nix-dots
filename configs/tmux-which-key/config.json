    {
      "key": "n",
      "type": "group",
      "description": "navigation (prefix-free)",
      "items": [
        { "key": "h", "type": "tmux", "command": "select-pane -L", "description": "Select left (Alt+Left)" },
        { "key": "j", "type": "tmux", "command": "select-pane -D", "description": "Select down (Alt+Down)" },
        { "key": "k", "type": "tmux", "command": "select-pane -U", "description": "Select up (Alt+Up)" },
        { "key": "l", "type": "tmux", "command": "select-pane -R", "description": "Select right (Alt+Right)" },
        { "key": "H", "type": "tmux", "command": "previous-window", "description": "Previous window (Alt+H)" },
        { "key": "L", "type": "tmux", "command": "next-window", "description": "Next window (Alt+L)" },
        { "key": "[S-Left]", "type": "tmux", "command": "previous-window", "description": "Previous window (Shift+Left)" },
        { "key": "[S-Right]", "type": "tmux", "command": "next-window", "description": "Next window (Shift+Right)" },
        { "key": "8", "type": "tmux", "command": "resize-pane -U", "description": "Resize up (Alt+8)" },
        { "key": "2", "type": "tmux", "command": "resize-pane -D", "description": "Resize down (Alt+2)" },
        { "key": "6", "type": "tmux", "command": "resize-pane -R", "description": "Resize right (Alt+6)" },
        { "key": "4", "type": "tmux", "command": "resize-pane -L", "description": "Resize left (Alt+4)" },
        { "key": "[C-h]", "type": "tmux", "command": "previous-window", "description": "Previous window (Ctrl+H)" },
        { "key": "[C-l]", "type": "tmux", "command": "next-window", "description": "Next window (Ctrl+L)" },
        { "key": "[C-S-H]", "type": "tmux", "command": "swap-window -t -1 \\; select-window -t -1", "description": "Swap window left (Ctrl+Shift+H)" },
        { "key": "[C-S-L]", "type": "tmux", "command": "swap-window -t +1 \\; select-window -t +1", "description": "Swap window right (Ctrl+Shift+L)" },
