    { "key": "d", "type": "tmux", "command": "display-panes", "description": "Display panes" },
    { "key": "e", "type": "tmux", "command": "new-window -n \"#{TMUX_CONF_LOCAL}\" sh -c '_E=${VISUAL:-${EDITOR:-vim}}; case \"$_E\" in *vim*) $_E -c \":set syntax=tmux\" \"$TMUX_CONF_LOCAL\";; *) $_E \"$TMUX_CONF_LOCAL\";; esac && \"$TMUX_PROGRAM\" ${TMUX_SOCKET:+-S \"$TMUX_SOCKET\"} source \"$TMUX_CONF\" \\; display \"Configuration reloaded\"'", "description": "Edit config" },
    { "key": "F", "type": "tmux", "command": "run \"cut -c3- '#{TMUX_CONF}' | sh -s _fpp '#{pane_id}'\"", "description": "Facebook pathpicker" },
    { "key": "[Enter]", "type": "tmux", "command": "copy-mode", "description": "Enter copy mode" },
    { "key": "m", "type": "tmux", "command": "set -gF mouse '#{?mouse,off,on}' \\; display \"mouse: #{?mouse,on,off}\"", "description": "Toggle mouse" },
    { "key": ">", "type": "tmux", "command": "swap-pane -D", "description": "Swap pane down" },
    { "key": "<", "type": "tmux", "command": "swap-pane -U", "description": "Swap pane up" },
    { "key": "-", "type": "tmux", "command": "split-window -v -c '#{pane_current_path}'", "description": "Split horizontal" },
    { "key": "_", "type": "tmux", "command": "split-window -h -c '#{pane_current_path}'", "description": "Split vertical" },
    { "key": "U", "type": "tmux", "command": "run \"cut -c3- '#{TMUX_CONF}' | sh -s _urlscan '#{pane_id}' $tmux_conf_urlscan_options\"", "description": "URL scan" },
    { "key": "y", "type": "tmux", "command": "run -b \"\\\"$TMUX_PROGRAM\\\" \\${TMUX_SOCKET:+-S \\\"$TMUX_SOCKET\\\"} save-buffer - | $clipboard_command\"", "description": "Copy to clipboard" },
    {
      "key": "T",
      "type": "group",
      "description": "tmux plugins",
      "items": [
        { "key": "i", "type": "tmux", "command": "run-shell '~/.tmux/plugins/tpm/scripts/install_plugins.sh'", "description": "Install plugins" },
        { "key": "u", "type": "tmux", "command": "run-shell '~/.tmux/plugins/tpm/scripts/update_plugins.sh'", "description": "Update plugins" },
        { "key": "M-u", "type": "tmux", "command": "run-shell '~/.tmux/plugins/tpm/scripts/clean_plugins.sh'", "description": "Uninstall plugins" }
      ]
    }
